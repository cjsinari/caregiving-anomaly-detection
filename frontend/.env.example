# Where the auth service lives. Left unset, the dashboard calls /api and the Vite
# dev server proxies that to AUTH_SERVICE_URL (default http://127.0.0.1:3000).
# Set this only for a deployed build served from a different origin than the API.
VITE_API_BASE_URL=/api

# The auth service the dev proxy forwards to.
AUTH_SERVICE_URL=http://127.0.0.1:3000

# Minutes of no keyboard or pointer activity before the console locks itself.
VITE_IDLE_TIMEOUT_MINUTES=15
